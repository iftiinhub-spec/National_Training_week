PORT=5113
NODE_ENV=production

# MongoDB
MONGODB_URI=mongodb://admin:your_password@localhost:27017/hu_ntw?authSource=admin

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Email: production cPanel IP-authorized SMTP relay
EMAIL_TRANSPORT=smtp-relay
SMTP_HOST=webmail.hu.edu.so
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="National Training Week <info@ntw.hu.edu.so>"
CERTIFICATE_LOGO_PATH=../frontend/public/logo.png
CERTIFICATE_SIGNATURE_PATH=assets/signature.png
CERTIFICATE_SIGNATORY_NAME=Authorized Signatory
CERTIFICATE_SIGNATORY_TITLE=Program Director

# Public URLs and CORS
FRONTEND_URL=https://ntw.elivateict.com
BACKEND_URL=https://ntw.elivateict.com
CORS_ORIGINS=https://ntw.elivateict.com

# File upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Admin seed (initial admin account)
ADMIN_EMAIL=admin@nationaltrainingweek.so
ADMIN_PASSWORD=Admin@2026
ADMIN_NAME=System Administrator
