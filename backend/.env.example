PORT=5113
NODE_ENV=production

# MongoDB
MONGODB_URI=mongodb://admin:your_password@localhost:27017/hu_ntw?authSource=admin
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# Email: production cPanel IP-authorized SMTP relay
EMAIL_TRANSPORT=smtp-relay
SMTP_HOST=webmail.hu.edu.so
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="National Training Week <info@ntw.hu.edu.so>"
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES_PER_CONNECTION=100
SMTP_RATE_LIMIT_PER_SECOND=5
# Central email outbox (300/hour keeps a 50-message safety margin below a 350/hour provider limit)
EMAIL_MAX_PER_HOUR=300
EMAIL_MIN_INTERVAL_MS=12000
EMAIL_MAX_ATTEMPTS=5
EMAIL_LOCK_STALE_MS=600000
EMAIL_DELIVERY_MODE=enabled
DISABLE_EMAIL_WORKER=false
APPROVAL_DIGEST_WINDOW_MS=1800000
CERTIFICATE_DIGEST_WINDOW_MS=3600000
REMINDER_DIGEST_LOOKAHEAD_MS=86400000
ATTENDANCE_REVIEW_WINDOW_MS=21600000
ATTENDANCE_REVIEW_WORKER_POLL_MS=60000
DISABLE_ATTENDANCE_REVIEW_WORKER=false
CERTIFICATE_NTW_LOGO_PATH=../frontend/public/Logo ntw full og.png
CERTIFICATE_SIGNATURE_PATH=assets/signature.png
CERTIFICATE_SIGNATORY_NAME=Authorized Signatory
CERTIFICATE_SIGNATORY_TITLE=Program Director

# Public URLs and CORS
FRONTEND_URL=https://ntw.hu.edu.so
BACKEND_URL=https://ntw.hu.edu.so
CORS_ORIGINS=https://ntw.hu.edu.so,https://www.ntw.hu.edu.so
TRUST_PROXY=1
API_RATE_LIMIT_MAX=5000

# QR attendance: one fixed code per opening, valid for ten minutes. Moderators
# may start a code from 15 minutes before until 60 minutes after the session.
QR_SESSION_MINUTES=10
QR_WINDOW_BEFORE_MINUTES=15
QR_WINDOW_AFTER_MINUTES=60

# File upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Background certificate delivery
CERTIFICATE_BATCH_SIZE=25
CERTIFICATE_WORKER_POLL_MS=2000
CERTIFICATE_EMAIL_MAX_ATTEMPTS=5
CERTIFICATE_RETRY_DELAY_MS=60000
CERTIFICATE_JOB_STALE_MS=600000
CERTIFICATE_JOB_MAX_RUNS=500
PDF_MAX_CONCURRENT=2
PDF_MAX_QUEUE=100

# Admin seed (initial admin account)
ADMIN_EMAIL=admin@nationaltrainingweek.so
ADMIN_PASSWORD=replace_with_a_unique_strong_password
ADMIN_NAME=System Administrator
