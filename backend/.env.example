PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/hu_ntw

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Hormuud University NTW <no-reply@hormuud.edu.so>

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# File upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Admin seed (initial admin account)
ADMIN_EMAIL=admin@hormuud.edu.so
ADMIN_PASSWORD=Admin@2026
ADMIN_NAME=System Administrator
